# Run node scripts/init-env.mjs to generate a new .env with random secrets.
APP_PORT=8101
BIND_ADDRESS=127.0.0.1
DATA_DIR=./data
POSTGRES_PASSWORD=
APP_ENCRYPTION_KEY=
# Local admin only; ignored with FjordHub enabled. Existing password is never reset by restart.
FIRST_ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8101
# Set to 1 when using HTTPS through FjordHub or another reverse proxy.
COOKIE_SECURE=0
FJORDHUB_URL=
FJORDHUB_API_KEY=
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
# npm run dev (not used by Compose)
DEV_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://fjordmail:CHANGE_ME@127.0.0.1:5432/fjordmail
